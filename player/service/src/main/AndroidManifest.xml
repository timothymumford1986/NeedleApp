<?xml version="1.0" encoding="utf-8"?>
<!--
  :player:service declares the foreground-service permissions it is the reason
  for, and the <service> element for the one MediaLibraryService. Both are also
  declared in app/src/main/AndroidManifest.xml in the case of the permissions;
  duplicate <uses-permission> entries merge to one.

  The <service> lives here rather than in :app so the declaration sits beside
  the class it names. REQUIREMENTS.md "Surfaces beyond the app": six surfaces
  share this one session.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>

        <!--
          The one foreground service in the app. Downloads run as expedited
          WorkManager jobs instead, so this is the only mediaPlayback type
          declared anywhere.

          android:exported is true because the whole point is that other
          processes drive it: the platform media button receiver, Android Auto,
          the Wear companion and any media client on the device.

          Two actions, deliberately:
            * MediaSessionService is what a Media3 MediaController connects to —
              the app's own UI, the widgets, Wear.
            * MediaBrowserService is the legacy browse interface, and it is what
              makes Android Auto and older media clients able to browse at all.
              REQUIREMENTS.md wants Auto browse and search from the start,
              because retrofitting it means restructuring playback.
        -->
        <service
            android:name=".session.NeedlerPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

    </application>

</manifest>
