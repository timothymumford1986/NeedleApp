<?xml version="1.0" encoding="utf-8"?>
<!--
  Needler application manifest.

  Deliberately absent, because other work is writing those classes:
    * the <service> for the Media3 MediaLibraryService, which belongs in
      player/service/src/main/AndroidManifest.xml next to the class it names
    * the Glance <receiver> entries, which belong in
      widget/src/main/AndroidManifest.xml
    * the Android Auto <meta-data android:name="com.google.android.gms.car.application">
      and its automotive_app_desc resource
  Declaring an element that names a class which does not exist yet merges fine
  but fails lint's MissingClass check, so each one lands with its class.

  android:label is a literal rather than @string/app_name so this file does not
  depend on a strings.xml that does not exist yet.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talking to the DroppedNeedle server at all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Required to tell a metered connection from an unmetered one, which three
      separate requirements depend on: "Stream on mobile data: MP3 320" only
      while metered, "Download to device on Wi-Fi only", and respecting Data
      Saver (no artwork prefetch, no speculative buffering when restricted).
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Pull finished / pull failed / new release notifications (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      One foreground service only, for media playback, owned by the Media3
      session. Offline downloads run as expedited WorkManager jobs instead.
      FOREGROUND_SERVICE_MEDIA_PLAYBACK is mandatory from targetSdk 34.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Keeps playback alive with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".NeedlerApplication"
        android:label="Needler"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:theme="@style/Theme.Needler"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          The one activity. Needler is a single-activity Compose app: Connect,
          the four navigation destinations and every screen a feature module
          adds are composables inside this host, not separate activities.

          android:theme is the splash theme rather than Theme.Needler, because
          androidx.core.splashscreen needs a Theme.SplashScreen window to read
          `windowSplashScreenBackground` and `postSplashScreenTheme` from.
          `installSplashScreen()` swaps the window to Theme.Needler before the
          first frame. See res/values/themes.xml.

          android:exported is mandatory from API 31 for anything with an
          intent-filter, and a LAUNCHER activity is exported by definition.

          adjustResize keeps the Connect form above the IME rather than letting
          the keyboard cover the password field; Compose's imePadding works off
          the same signal.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Needler"
            android:theme="@style/Theme.Needler.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager's default initializer is removed, and this is the half of
          that change that lives in a manifest. The other half is
          NeedlerApplication implementing Configuration.Provider with the
          injected HiltWorkerFactory; neither is correct without the other.

          Without the removal, androidx.startup initialises WorkManager at
          content-provider time with its default worker factory, which cannot
          construct a @HiltWorker: every job would then fail at start, on a
          background thread, with nothing in the app reporting it. With the
          removal, WorkManager initialises on demand the first time
          WorkManager.getInstance is called and reads the configuration above.

          Only the WorkManagerInitializer meta-data is removed, not the provider
          itself: androidx.startup is shared, and tools:node="remove" on the
          <provider> would take every other library's initializer with it.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
