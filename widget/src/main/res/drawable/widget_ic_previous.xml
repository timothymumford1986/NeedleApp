<?xml version="1.0" encoding="utf-8"?>
<!--
  Previous, traced from the `aria-label="Previous"` button on screens 15 and 18:

      <path d="M18 5v14L9 12z" fill="currentColor" stroke="none"/>
      <path d="M6 5v14"/>            stroke-width 1.8, round caps

  22dp drawn inside the pack's own 24-unit viewport, so the geometry below is
  the pack's numbers unchanged.

  The colour is baked into the drawable rather than applied with
  Glance's ColorFilter.tint. These glyphs only ever appear in one place and one
  colour — NeedlerColors.textPrimary on the card, NeedlerColors.onAccent on the
  accent disc — and every tint a widget applies is another RemoteViews action
  the launcher has to replay on every rebind.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp"
    android:height="22dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="@color/needler_widget_text_primary"
        android:pathData="M18,5 v14 L9,12 z" />

    <path
        android:pathData="M6,5 v14"
        android:strokeColor="@color/needler_widget_text_primary"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

</vector>
