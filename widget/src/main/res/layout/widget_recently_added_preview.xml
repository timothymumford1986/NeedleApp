<?xml version="1.0" encoding="utf-8"?>
<!--
  The picture the Android 12+ widget picker shows before the recently added
  widget is placed.

  It is a static layout, not a Glance composition: the picker inflates it in its
  own process with no Hilt graph, no Room mirror and no app process running, so
  it cannot be the real card.

  It draws the **empty state** rather than a fabricated album, for the same
  reason widget_now_playing_preview.xml does. A preview showing "Mordechai —
  Khruangbin" would be a promise about a library this device may not have synced,
  and the empty card is what a user actually gets the moment they drop it on a
  fresh install. It also means the preview uses the product's real strings
  instead of sample data that would drift from them.

  The Play disc is absent, matching the card itself: with no album there is
  nothing for it to play, and RecentlyAddedModel.canPlay hides it.

  Only views RemoteViews supports are used (LinearLayout, ImageView, TextView),
  because a preview layout has the same restrictions as the widget itself.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:minHeight="140dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- The 56dp cover, as the tinted placeholder: nothing synced, so there is no art. -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_artwork_placeholder"
        android:contentDescription="@string/widget_artwork" />

    <!-- The pack's `justify-content: space-between`, as a weighted gap. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_recently_added_eyebrow"
        android:textColor="@color/needler_widget_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="@string/widget_recently_added_empty"
        android:textColor="@color/needler_widget_text_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="@string/widget_recently_added_empty_detail"
        android:textColor="@color/needler_widget_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
